# Public Supabase client config (anon/publishable key only; RLS is required)
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>

# Optional public client inputs
EXPO_PUBLIC_GIPHY_API_KEY=<your-giphy-client-key>
EXPO_PUBLIC_API_BASE_URL=<your-api-base-url>
EXPO_PUBLIC_OAUTH_PORTAL_URL=<your-oauth-portal-url>
EXPO_PUBLIC_OAUTH_SERVER_URL=<your-oauth-server-url>
EXPO_PUBLIC_APP_ID=<your-public-app-id>

# Never put MANUS_API_KEY, MANUS_JWT_SECRET, Supabase service_role,
# database passwords, signing keys, Expo tokens, or model-provider secrets here.
# Keep server secrets in the protected server environment, not in the mobile bundle.
